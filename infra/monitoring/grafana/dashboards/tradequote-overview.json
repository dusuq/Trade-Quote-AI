{
  "uid": "tradequote-overview",
  "title": "TradeQuote AI — Platform Overview",
  "description": "Service availability, probe latency, and live logs for all deployable units. Generated targets come from infra/services.yml.",
  "tags": ["overview", "security", "t309", "t310b", "tradequote"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "tradequote-prometheus"
        },
        "query": "label_values(probe_success{job=\"service-health\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Units up",
      "description": "Count of deployable units currently passing their /health probe.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(probe_success{job=\"service-health\"})",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "green",
                "value": 12
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Units down",
      "description": "Any non-zero value here should have a matching alert firing.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"service-health\"} == 0) or vector(0)",
          "legendFormat": "down"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical path health",
      "description": "Public edge (api-gateway) and money path (payment-service). Anything below 100% is customer-visible.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(probe_success{job=\"service-health\", criticality=\"critical\"}) * 100",
          "legendFormat": "critical units healthy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Health probe success by service",
      "description": "1 = healthy, 0 = failing. Flapping between the two is usually resource exhaustion or a dependency timeout inside /health.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"service-health\", service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "lastNotNull"]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Health probe duration by service",
      "description": "/health is dependency-light by design, so this should sit in the low milliseconds. Sustained growth is the earliest saturation signal available without in-app metrics.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"service-health\", service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Availability % (1h rolling) by service",
      "description": "The number an SLO conversation actually needs. 99.9% over 30 days allows ~43 minutes of downtime.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_success{job=\"service-health\", service=~\"$service\"}[1h]) * 100",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "min"]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "TLS certificate — days until expiry",
      "description": "Cloudflare and Fly auto-renew; a downward trend crossing 14 days means renewal is genuinely stuck.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 14
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Recent error logs (all services)",
      "description": "Loki-backed. Correlate a dip in the panels above with what the process actually said.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "loki",
        "uid": "tradequote-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".+\"} |~ \"(?i)(error|exception|traceback|critical)\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request rate by service (T309b)",
      "description": "Real application traffic from each unit's own /metrics, not the /health probe. Requires the app-metrics scrape job.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"app-metrics\", service=~\"$service\"}[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "5xx error rate % by service (T309b)",
      "description": "Server-error responses as a share of all requests. Can be non-zero while /health stays green — this is the traffic-health signal, not the liveness signal.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"app-metrics\", service=~\"$service\", status_code=~\"5..\"}[5m])) by (service) / sum(rate(http_requests_total{job=\"app-metrics\", service=~\"$service\"}[5m])) by (service) * 100",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "p99 request latency by service (T309b)",
      "description": "Real endpoint latency, aggregated across a service's own routes — not just /health.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"app-metrics\", service=~\"$service\"}[5m])) by (le, service))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Auth failures by reason (T310b)",
      "description": "Requests the gateway refused, split by why. invalid_signature and invalid_algorithm cannot happen by accident — those are forgery attempts and page via TokenForgeryAttempt. missing_token and expired_token are ordinary traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(auth_failures_total{job=\"app-metrics\"}[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Cross-tenant attempts (T310b)",
      "description": "Clients supplying an identity header that contradicts their verified token claims. The request is never served with the spoofed identity — proxy.ts strips and re-derives it — so any line here is an attempt, not a breach. There is no benign cause: a non-zero value means someone is probing tenant isolation.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cross_tenant_attempts_total{job=\"app-metrics\"}[5m])) by (header, authenticated)",
          "legendFormat": "{{header}} (authenticated={{authenticated}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Login outcome & failure reasons (T310b)",
      "description": "auth-service credential checks — a signal the gateway cannot produce, since it never sees a login body. A failure mix dominated by unknown_user is credential stuffing; dominated by bad_password is a targeted brute force against real accounts.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "tradequote-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(auth_login_attempts_total{job=\"app-metrics\"}[5m])) by (result)",
          "legendFormat": "attempts: {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(auth_login_failures_total{job=\"app-metrics\"}[5m])) by (reason)",
          "legendFormat": "failed: {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        }
      }
    }
  ]
}
