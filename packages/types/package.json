{
  "name": "@tradequote/types",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth: shared types, domain-event registry, contract envelopes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@tradequote/config": "workspace:*",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  }
}
