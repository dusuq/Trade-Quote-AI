# ============================================================
# TradeQuote AI — LOCAL ENVIRONMENT (.env.local)
# Template — safe to commit. Copy to .env.local and fill in.
# This file is git-ignored. Copy structure from .env.example.
# ============================================================

# ---- Core ----
NODE_ENV=
APP_ENV=
APP_NAME=
APP_URL=
API_URL=
# Browser-exposed — apps/web reads this to reach the API Gateway (T108).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Database (PostgreSQL) ----
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Redis ----
REDIS_URL=

# ---- Object Storage (S3-compatible / MinIO for local) ----
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# ---- Search (OpenSearch, optional local) ----
OPENSEARCH_URL=

# ---- Auth (Clerk / Auth0 — choose one) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=

# ---- AI Providers ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENAI_API_KEY=
WHISPER_API_KEY=
# Vector store for AI memory (pgvector uses DATABASE_URL; or Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=

# ---- Notifications ----
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_TOKEN=

# ---- Integrations ----
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Feature Flags ----
FEATURE_AI_VOICE=
FEATURE_AI_VISION=
FEATURE_OFFLINE_SYNC=
FEATURE_PAYMENTS=
