{
  "name": "@tradequote/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "TradeQuote AI — API Gateway / BFF (JWT auth, rate limiting, service routing)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
